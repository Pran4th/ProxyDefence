# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_DB=defenseintel
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me

# --- Elasticsearch ---
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTIC_PASSWORD=change-me

# --- JWT ---
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://localhost:8081

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# --- LLM (Groq via OpenAI-compatible API — REQUIRED for Copilot, Agents, AI features) ---
# Set your Groq API key (starts with gsk_) and base URL to https://api.groq.com/openai/v1
# Or swap to any OpenAI-compatible provider by changing the base URL and models.
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.groq.com/openai/v1
LLM_DEFAULT_MODEL=llama-3.3-70b-versatile
LLM_FALLBACK_MODEL=llama-3.1-8b-instant

# --- GNews API ---
NEWS_API_KEY=replace-me

# --- Tier 2 data acquisition APIs ---
AISSTREAM_API_KEY=replace-me
EIA_API_KEY=replace-me
CRUDE_PRICE_API_KEY=replace-me
NEWSDATA_API_KEY=replace-me

# --- Frontend ---
VITE_API_URL=http://localhost:8000

# --- Service Metadata ---
SERVICE_VERSION=1.0.0
GIT_COMMIT=unknown
ENVIRONMENT=development

# --- Energy Service ---
ENERGY_LOAD_SEED=1

# --- ML Platform ---
MLFLOW_TRACKING_URI=file:./mlruns
DVC_REMOTE=./data/dvc-store
ENERGY_SERVICE_URL=http://energy-service:8000

# --- Embedding Service ---
EMBEDDING_SERVICE_URL=http://embedding-service:8000

# --- Logging ---
LOG_LEVEL=INFO
