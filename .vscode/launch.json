{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Ingest Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "0.0.0.0", "--port", "8001", "--reload"],
      "cwd": "${workspaceFolder}/services/ingest-service",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENVIRONMENT": "development"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ML Platform Consumer",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/services/ml-platform/consumer/article_enrichment.py",
      "cwd": "${workspaceFolder}/services/ml-platform",
      "env": {
        "PYTHONPATH": "${workspaceFolder};${workspaceFolder}/services/ml-platform",
        "ENVIRONMENT": "development",
        "KAFKA_BOOTSTRAP_SERVERS": "127.0.0.1:9092"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Embedding Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "0.0.0.0", "--port", "8005", "--reload"],
      "cwd": "${workspaceFolder}/services/embedding-service",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENVIRONMENT": "development"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Database Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "0.0.0.0", "--port", "8003", "--reload"],
      "cwd": "${workspaceFolder}/services/database-service",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENVIRONMENT": "development"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Energy Service",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "0.0.0.0", "--port", "8006", "--reload"],
      "cwd": "${workspaceFolder}/services/energy-service",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENVIRONMENT": "development",
        "ENERGY_LOAD_SEED": "1"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "ML Platform",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app:app", "--host", "0.0.0.0", "--port", "8007", "--reload"],
      "cwd": "${workspaceFolder}/services/ml-platform",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENVIRONMENT": "development",
        "ENERGY_SERVICE_URL": "http://localhost:8006"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Modular API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["backend.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--reload"],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}",
        "ENVIRONMENT": "development"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
